#!/usr/bin/env bash
# Turn the Surface cameras on and off.
#
#   start-camera      # begin feeding the virtual webcams
#   stop-camera       # stop, and power the sensors down
#   surface-camera {start|stop|restart|status}
#
# start-camera and stop-camera are symlinks to this script; it dispatches on the
# name it was invoked as, so there is one implementation rather than three.
#
# Installed into ~/.local/bin, which every shell has on PATH, rather than being a
# shell alias: an alias only exists in interactive shells that source the right
# rc file, needs different syntax for bash, zsh and fish, and is invisible to
# scripts, cron jobs and desktop launchers.
#
# The bridge services ship disabled, so the cameras are off until you ask for
# them. While stopped the loopback devices have no producer and apps will not
# list them -- that is the point: the sensor is not running and the privacy LED
# is off. Run start-camera before a call.
set -uo pipefail

# Substituted at install time, the same way the systemd unit is.
REPO="%REPO%"

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m  ok\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m FAIL\033[0m %s\n' "$*" >&2; exit 1; }

# Which services to act on. surfacecam/config.py is the source of truth; if the
# repo has moved or python3 is broken, fall back to whatever instances systemd
# actually knows about, so the off switch keeps working when the rest does not.
services() {
	local out
	if out="$(cd -- "${REPO}" 2>/dev/null && python3 -m surfacecam.config services 2>/dev/null)" &&
		[[ -n ${out} ]]; then
		printf '%s\n' "${out}"
		return 0
	fi
	out="$(systemctl --user list-units --all --no-legend 'camera-bridge@*.service' 2>/dev/null |
		awk '{print $1}' | grep -v '^camera-bridge@\.service$' | sort -u | tr '\n' ' ')"
	[[ -n ${out} ]] || die "no camera-bridge services found; is it installed? (${REPO})"
	warn "using systemd's instance list; surfacecam.config was unreadable at ${REPO}"
	printf '%s\n' "${out}"
}

report() {
	if (cd -- "${REPO}" 2>/dev/null && python3 -m surfacecam.cli status 2>/dev/null); then
		return 0
	fi
	local svc
	for svc in ${1}; do
		printf '  %-22s %s\n' "${svc}" "$(systemctl --user is-active "${svc}")"
	done
}

action="${1:-}"
case "$(basename -- "$0")" in
start-camera) action=start ;;
stop-camera) action=stop ;;
esac

svcs="$(services)"
# shellcheck disable=SC2086  # deliberately word-split into separate unit names
case "${action}" in
start)
	log "Starting the cameras"
	systemctl --user start ${svcs} || die "could not start: ${svcs}"
	# The bridge waits for its PipeWire node before it can publish anything, so
	# give it a moment before reporting, or the first status always reads unready.
	sleep 6
	report "${svcs}"
	ok "cameras on"
	;;
stop)
	log "Stopping the cameras"
	systemctl --user stop ${svcs} || die "could not stop: ${svcs}"
	ok "cameras off (the sensors are powered down and apps will not list them)"
	;;
restart)
	systemctl --user restart ${svcs} || die "could not restart: ${svcs}"
	sleep 6
	report "${svcs}"
	;;
status)
	report "${svcs}"
	;;
*)
	die "usage: $(basename -- "$0") {start|stop|restart|status}"
	;;
esac
