Subject: [PATCH 2/2] media: ov5693: program MIPI_CTRL00 on stream enable

The stock driver's stream-enable path writes only SW_STREAM (0x0100); it never
touches MIPI_CTRL00 (0x4800). On the Surface Pro 9 the IPU6 CSI-2 receiver then
fails to lock its D-PHY, and every capture hangs with

  intel_ipu6_isys.isys intel_ipu6.isys.40: stream stop time out
  intel_ipu6_isys.isys intel_ipu6.isys.40: stream close time out

Write 0x2d to MIPI_CTRL00 immediately before the stream-on write, so the clock
lane is configured before the sensor starts pushing pixels. cci_write()'s
trailing &ret makes the sequencing safe: a failed first write short-circuits the
second.

The value is a module parameter rather than a bare constant. It is documented in
prose only (linux-surface discussion #2198 carries no diff) and that discussion
mentions 0x20 as another value tried, so being able to sweep candidates with a
modprobe argument instead of a rebuild is worth the one extra symbol.
mipi_ctrl00=-1 skips the write entirely and reproduces stock behaviour, which is
how the A/B in tests/test-capture.sh demonstrates the fix.

Not applied on stream-off: the sensor is going idle either way.

Ref: https://github.com/linux-surface/linux-surface/discussions/2198

--- a/drivers/media/i2c/ov5693.c
+++ b/drivers/media/i2c/ov5693.c
@@ -10,6 +10,20 @@
  * Tsuchiya Yuto
  * Jordan Hand
  * Jake Day
+ *
+ * Out-of-tree fork for Microsoft Surface devices that pair an OV5693 with an
+ * Intel IPU6 (sp9-ov5693-dkms). Developed and verified on the Surface Pro 9;
+ * nothing below is SP9-specific, so it applies to any such Surface.
+ *
+ * Base: drivers/media/i2c/ov5693.c from Linux v6.19,
+ *       sha256 e4d5f9c4c148f1664bb1d4ae37c1095d9de42109907db71439f2f26f6519ea1c
+ *
+ * Deltas versus that base (both kept as readable patches under patches/):
+ *   0001 - add the "OVTI5693" ACPI HID (carried from linux-surface
+ *          patches/6.19/0013-cameras.patch; without it the sensor stops binding)
+ *   0002 - program MIPI_CTRL00 (0x4800) in the stream-enable path, without which
+ *          the IPU6 D-PHY never locks and intel_ipu6_isys reports
+ *          "stream stop time out" / "stream close time out"
  */
 
 #include <linux/acpi.h>
@@ -35,6 +49,16 @@
 #define OV5693_STOP_STREAMING			0x00
 #define OV5693_SW_RESET				0x01
 
+/*
+ * MIPI Control. The sensor comes out of reset with a clock-lane configuration the
+ * IPU6 CSI-2 receiver cannot lock onto, and the stock driver never touches this
+ * register, so the D-PHY stays unlocked and every capture hangs. 0x2d is the value
+ * reported to work on Surface hardware; see docs/RUNBOOK.md for the alternatives.
+ */
+#define OV5693_MIPI_CTRL00_REG			CCI_REG8(0x4800)
+#define OV5693_MIPI_CTRL00_IPU6			0x2d
+#define OV5693_MIPI_CTRL00_SKIP			-1
+
 #define OV5693_REG_CHIP_ID			CCI_REG16(0x300a)
 /* Yes, this is right. The datasheet for the OV5693 gives its ID as 0x5690 */
 #define OV5693_CHIP_ID				0x5690
@@ -122,6 +146,11 @@
 #define OV5693_LINK_FREQ_419_2MHZ		419200000
 #define OV5693_PIXEL_RATE			167680000
 
+static int mipi_ctrl00 = OV5693_MIPI_CTRL00_IPU6;
+module_param(mipi_ctrl00, int, 0644);
+MODULE_PARM_DESC(mipi_ctrl00,
+		 "Value written to MIPI_CTRL00 (0x4800) on stream enable, -1 to skip the write");
+
 #define to_ov5693_sensor(x) container_of(x, struct ov5693_device, sd)
 
 static const char * const ov5693_supply_names[] = {
@@ -611,6 +640,15 @@
 {
 	int ret = 0;
 
+	/*
+	 * Program the MIPI clock lane before the sensor starts pushing pixels, so
+	 * the receiver has a lockable D-PHY by the time the first packet lands.
+	 * Skipped on stream-off: the sensor is about to go idle either way.
+	 */
+	if (enable && mipi_ctrl00 != OV5693_MIPI_CTRL00_SKIP)
+		cci_write(ov5693->regmap, OV5693_MIPI_CTRL00_REG, mipi_ctrl00,
+			  &ret);
+
 	cci_write(ov5693->regmap, OV5693_SW_STREAM_REG,
 		  enable ? OV5693_START_STREAMING : OV5693_STOP_STREAMING,
 		  &ret);
@@ -1419,5 +1457,6 @@
 };
 module_i2c_driver(ov5693_driver);
 
-MODULE_DESCRIPTION("A low-level driver for OmniVision 5693 sensors");
+MODULE_DESCRIPTION("A low-level driver for OmniVision 5693 sensors (Surface IPU6 MIPI_CTRL00 fork)");
+MODULE_VERSION("1.0.0");
 MODULE_LICENSE("GPL");
